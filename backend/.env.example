# Copy this file to .env and fill it in. .env is gitignored; never commit real keys.
# Every setting in app/config.py can be set here with the FOOTNOTE_ prefix.

# Which LLM writes answers: anthropic, openai, or ollama.
FOOTNOTE_LLM_PROVIDER=anthropic
FOOTNOTE_ANTHROPIC_API_KEY=

# Free local alternative (no key needed): run `ollama pull llama3.2:3b`, then use
# FOOTNOTE_LLM_PROVIDER=ollama
